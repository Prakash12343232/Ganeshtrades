# OTP SERVER ENVIRONMENT CONFIGURATION EXAMPLE
NODE_ENV=production
PORT=5001

# DATABASE
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ganeshtrades_otp?retryWrites=true&w=majority

# SECURITY & RATE LIMITING
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_HASH_SECRET=your_super_secret_sha256_salt_key

# SERVER-TO-SERVER AUTHENTICATION (Shared with Ganesh Backend)
OTP_SERVICE_API_KEY=your_secure_server_to_server_api_key_here

# SMS PROVIDER CONFIGURATION (Supports: fast2sms, twilio, mock)
SMS_PROVIDER=fast2sms

# FAST2SMS (if using Fast2SMS)
SMS_API_KEY=your_fast2sms_api_key
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# TWILIO (if using Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEMPLATE_NAME=
