{
  "name": "ganesh-trades-root",
  "version": "1.0.0",
  "description": "Ganesh Trades Full Stack Application",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "otp-server"
  ],
  "scripts": {
    "build-frontend": "npm run build --prefix frontend",
    "build": "npm run build-frontend",
    "start": "node backend/server.js",
    "dev": "npm run build-frontend && node backend/server.js",
    "lint": "npm run lint --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "start:otp": "npm start --prefix otp-server",
    "test:otp": "npm test --prefix otp-server",
    "verify:prod": "node scripts/verify-production.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "twilio": "^6.1.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
