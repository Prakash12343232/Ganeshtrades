# ─── Ganesh Trades Backend Environment Variables ───
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# JWT authentication secret (min 32 chars in production)
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>
JWT_EXPIRE=7d

# Frontend URL for CORS (comma-separated for multiple origins)
# Development: http://localhost:5173
# Production:  https://your-app.vercel.app,https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173
