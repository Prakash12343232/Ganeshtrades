# GANESH TRADERS BACKEND CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit .env with real credentials.

# Application Environment
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ganeshtrades?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d
ADMIN_PASSWORD=SecureAdmin@123

# Frontend CORS Origin(s) (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,https://ganeshtrades.vercel.app

# SMS Gateway Selection (optional: 'fast2sms' or 'twilio'; auto-detected if omitted)
SMS_PROVIDER=fast2sms

# SMS Gateway — Fast2SMS (Recommended for India)
# 1. Quick OTP Route (Default — no custom DLT registration needed):
FAST2SMS_API_KEY=your_fast2sms_api_authorization_key_here
FAST2SMS_ROUTE=otp

# 2. DLT Template Route (Optional — only if using custom DLT-approved template):
# FAST2SMS_ROUTE=dlt
# FAST2SMS_SENDER_ID=your_dlt_6_char_sender_id
# FAST2SMS_TEMPLATE_ID=your_dlt_template_id

# SMS Gateway — Twilio (Alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEMPLATE_NAME=

# Independent OTP Microservice (Optional: Leave empty for single-DB architecture)
OTP_SERVICE_URL=
OTP_SERVICE_API_KEY=
